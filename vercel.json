{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "buildCommand": "npm run build:personal",
      "devCommand": "VITE_PERSONAL=1 npm run dev -- --host 127.0.0.1 --port $PORT --strictPort",
      "outputDirectory": "dist"
    },
    "api": {
      "root": "services/api",
      "framework": "node",
      "entrypoint": "index.js",
      "installCommand": "true",
      "devCommand": "node ../dev.mjs",
      "functions": { "index.js": { "maxDuration": 180 } },
      "bindings": [{ "type": "service", "service": "coach", "format": "url", "env": "COACH_INTERNAL_URL" }]
    },
    "coach": {
      "root": "services/coach",
      "framework": "node",
      "entrypoint": "index.js",
      "installCommand": "true",
      "devCommand": "node ../dev.mjs",
      "functions": { "index.js": { "maxDuration": 180 } }
    }
  },
  "rewrites": [
    { "source": "/api/coach-plan", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ],
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/source/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
